# PhytoStress TF Atlas Environment Configuration

PROJECT_NAME="PhytoStress TF Atlas"
ENVIRONMENT="development"
DEBUG=true

# Database Connection
# SQLite for local development & testing:
DATABASE_URL="sqlite:///./phytostress.db"

# PostgreSQL for production deployment:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/phytostress_db"

# API & Security
API_V1_PREFIX="/api"
CORS_ORIGINS=["*"]
